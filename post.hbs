{{!< default}}

<main class="site-main">

    {{#post}}

    <article class="gh-article {{post_class}}">

        {{#if access}}

            <header class="gh-article-header gh-canvas">
                <span class="gh-article-meta"{{#if primary_tag.accent_color}} style="--tag-color: {{primary_tag.accent_color}};"{{/if}}>
                {{{t "By {authors}" authors=(authors) }}}
                    {{#if primary_tag}}
                        {{{t "in {primaryTag}" primaryTag=(concat "<a class=\"gh-article-tag\" href=\"" primary_tag.url "\">" primary_tag.name "</a>")}}}
                    {{/if}}
                    —
                    <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
                </span>

                <h1 class="gh-article-title">{{title}}</h1>

                {{#if custom_excerpt}}
                    <p class="gh-article-excerpt">{{custom_excerpt}}</p>
                {{/if}}

                {{> "post-image"}}
            </header>

            <div class="gh-content gh-canvas">
                {{content}}
            </div>

        {{else}}

            <div class="gh-content gh-canvas">
                {{!-- User is logged in but lacks permission to view  --}}
                {{#if @member}}
                    <section class="error-content">
                        <p class="error-message">Unable to view this post</p>
                        <a href="{{@site.url}}">Go home</a>
                    </section>
                {{!-- User is logged out and tried to access a non-public post --}}
                {{else}}
                    <p>This post has restricted access. <a href="#/portal/signin" data-portal="signin">Sign in</a> or <a href="#/portal/signup" data-portal="signup">sign up</a> to view it.</p>
                {{/if}}
            </div>

        {{/if}}

    </article>

    {{#if access}}
        {{!-- Navigation with prev/next hidden to prevent exposing inaccessible post titles/links --}}
        <div class="gh-canvas">
            <div class="navigation">
                {{!-- Keep 'prev' & 'next' elements to retain 'Share' center styling --}}
                <div class="navigation-previous-wrapper">
                    {{!-- <a class="navigation-item navigation-previous" href="/">
                        <span class="navigation-label"></span>
                        <h4 class="navigation-title"></h4>
                    </a> --}}
                </div>
                <div class="navigation-middle">
                    <a href="#/share" class="gh-button-share">{{t "Share"}} {{> "icons/share"}}</a>
                <div class="navigation-next-wrapper">
                    {{!-- <a class="navigation-item navigation-next" href="/">
                        <span class="navigation-label"></span>
                        <h4 class="navigation-title"></h4>
                    </a> --}}
                </div>
            </div>
        </div>
    {{/if}}

    {{#if comments}}
        {{#if access}}
            <div class="gh-comments gh-canvas">
                {{comments mode="auto"}}
            </div>
        {{/if}}
    {{/if}}

    {{/post}}

    {{#if @custom.show_related_posts}}
        {{> "related-posts"}}
    {{/if}}

</main>