{{> "darkmode-button"}}
<script>
(function () {
    var btns = document.querySelectorAll('.dm-toggle');
    if (!btns.length) return;

    function isDark() {
        return document.documentElement.classList.contains('dark');
    }

    function syncAria() {
        var pressed = isDark() ? 'true' : 'false';
        btns.forEach(function (b) { b.setAttribute('aria-pressed', pressed); });
    }

    {{!-- SODO is the search overlay/portal --}}
    var SODO_OVERRIDE_ID = 'dm-sodo-override';
    var SODO_OVERRIDE_CSS = [
        '.bg-white{background-color:#1a1a1a !important;}',
        '.bg-neutral-100{background-color:#2a2a2a !important;}',
        '.bg-neutral-200{background-color:#3a3a3a !important;}',
        '.bg-neutral-300{background-color:#4a4a4a !important;}',
        '.text-neutral-900,.text-neutral-800{color:#e6e6e6 !important;}',
        '.text-neutral-500,.text-neutral-400{color:#9a9a9a !important;}',
        '.placeholder\\:text-gray-400::placeholder{color:#6a6a6a !important;}',
        '.border-gray-200,.border-neutral-200{border-color:#2a2a2a !important;}',
        '.border-neutral-300{border-color:#3a3a3a !important;}',
        'input{color:#e6e6e6 !important;background-color:transparent !important;}',
        '.hover\\:text-neutral-500:hover{color:#cccccc !important;}',
        '.hover\\:text-black:hover{color:#ffffff !important;}',
        '.hover\\:border-neutral-300:hover{border-color:#4a4a4a !important;}'
    ].join('');

    {{!-- PORTAL is the account/profile/avatar modal --}}
    var PORTAL_OVERRIDE_ID = 'dm-portal-override';
    var PORTAL_OVERRIDE_CSS = [
        ':root{',
        /* Original blue theme ##2d3aff */
        /* This is to match when custom theme color is set to ##6a2eff */
        '--blakeman-theme-foreground: #694DFF;',
        '--blakeman-theme-link: #9D7CFF;',
        '--brandcolor: var(--blakeman-theme-foreground);',
        '--ghost-accent-color: var(--blakeman-theme-foreground);',

        '--primary-text-color: #e6e6e6;',
        '--white:#1a1a1a !important;',
        '--whitergb:26,26,26 !important;',
        '--black:#fff !important;',
        '--blackrgb:255,255,255 !important;',
        '--grey0:#f4f4f4 !important;',
        '--grey1:#e6e6e6 !important;',
        '--grey2:#d6d6d6 !important;',
        '--grey3:#bdbdbd !important;',
        '--grey4:#a4a4a4 !important;',
        '--grey5:#8a8a8a !important;',
        '--grey6:#7a7a7a !important;',
        '--grey7:#6a6a6a !important;',
        '--grey8:#555 !important;',
        '--grey9:#444 !important;',
        '--grey10:#3a3a3a !important;',
        '--grey11:#333 !important;',
        '--grey12:#2a2a2a !important;',
        '--grey13:#222 !important;',
        '--grey14:#1d1d1d !important;',
        '}',
        '.gh-portal-btn-primary{color:#fff !important;}',
        '.gh-portal-powered a{background:#1d1d1d !important;color:#e6e6e6 !important;}',
        /* Avatar icon (account screen) */
        '.gh-portal-avatar svg{color: var(--blakeman-theme-foreground) !important;}',
        /* Checkmark icon (tiers sign up screen) */
        '.gh-portal-benefit-checkmark path {stroke: var(--primary-text-color);}'

    ].join('');

    function applySodoOverride(iframe, dark) {
        if (!iframe.closest('#sodo-search-root')) return;
        try {
            var doc = iframe.contentDocument;
            if (!doc || !doc.head) return;
            var existing = doc.getElementById(SODO_OVERRIDE_ID);
            if (!dark) {
                if (existing) existing.remove();
                return;
            }
            if (existing) return;
            var style = doc.createElement('style');
            style.id = SODO_OVERRIDE_ID;
            style.textContent = SODO_OVERRIDE_CSS;
            doc.head.appendChild(style);
        } catch (e) {}
    }

    function applyPortalOverride(iframe, dark) {
        if (!iframe.closest('#ghost-portal-root')) return;
        if (iframe.title === 'portal-trigger') return;
        try {
            var doc = iframe.contentDocument;
            if (!doc || !doc.head) return;
            var existing = doc.getElementById(PORTAL_OVERRIDE_ID);
            if (!dark) {
                if (existing) existing.remove();
                return;
            }
            if (existing) return;
            var style = doc.createElement('style');
            style.id = PORTAL_OVERRIDE_ID;
            style.textContent = PORTAL_OVERRIDE_CSS;
            doc.head.appendChild(style);
        } catch (e) {}
    }

    function paintIframe(iframe, dark) {
        try {
            var doc = iframe.contentDocument;
            if (!doc || !doc.documentElement) return;
            doc.documentElement.style.colorScheme = dark ? 'dark' : 'light';
            applySodoOverride(iframe, dark);
            applyPortalOverride(iframe, dark);
        } catch (e) {}
    }

    function getGhostIframes() {
        return document.querySelectorAll('iframe[srcdoc]');
    }

    function trackIframe(iframe) {
        if (iframe.dataset.dmTracked === '1') return;
        iframe.dataset.dmTracked = '1';
        var paint = function () { paintIframe(iframe, isDark()); };
        iframe.addEventListener('load', paint);
        paint();
    }

    function syncAllIframes() {
        var dark = isDark();
        getGhostIframes().forEach(function (iframe) {
            trackIframe(iframe);
            paintIframe(iframe, dark);
        });
    }

    function notifyComments() {
        var root = document.getElementById('ghost-comments-root');
        if (root && root.parentElement) {
            root.parentElement.classList.toggle('dm-parent-flag');
        }
        syncAllIframes();
    }

    function apply(dark) {
        document.documentElement.classList.toggle('dark', dark);
        syncAria();
        notifyComments();
    }

    syncAria();

    btns.forEach(function (btn) {
        btn.addEventListener('click', function () {
            var next = !isDark();
            apply(next);
            document.cookie = 'darkmode-prefered=' + next + ';path=/;max-age=31536000;samesite=lax';
        });
    });

    new MutationObserver(syncAllIframes).observe(document.body, {childList: true, subtree: true});
    syncAllIframes();
})();
</script>
